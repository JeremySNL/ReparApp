@implements IDisposable
@inject NavigationManager NavigationManager

<header class="navbar">
    <div class="navbar-left">
        <a class="logo" href="">ReparApp</a>
    </div>

    <nav class="navbar-menu">
        <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
        <AuthorizeView>
            <Authorized>
                <NavLink href="counter">Counter</NavLink>
                <NavLink href="weather">Weather</NavLink>
                <NavLink href="auth">Auth</NavLink>
            </Authorized>
        </AuthorizeView>
    </nav>

    <div class="navbar-right">
        <AuthorizeView>
            <Authorized>
                <span class="user">@context.User.Identity?.Name</span>
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="Account/Login" />
                    <button type="submit" class="logout">Logout</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <NavLink href="Account/Login">Login</NavLink>
                <NavLink href="Account/Register">Register</NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</header>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}